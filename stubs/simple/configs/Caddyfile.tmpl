# Caddy Configuration for runlite (Simple Setup)
#
# This file is auto-generated from template during installation.
# To update: edit the template and re-run installer OR edit this file manually
# and reload: sudo systemctl reload caddy

# ============================================================================
# APPLICATION ROUTES
# ============================================================================

{{if .Domains}}
# Production domain(s)
{{range .Domains}}{{.}} {{end}}{
    reverse_proxy localhost:{{.Port}}

    # Optional: Add custom headers
    # header {
    #     X-Frame-Options "DENY"
    #     X-Content-Type-Options "nosniff"
    #     X-XSS-Protection "1; mode=block"
    # }

    # Optional: Enable compression
    # encode gzip
}
{{else}}
# Catch-all listener (no domain specified)
# Accepts any hostname, useful for IP-based access or before DNS is configured
:80 {
    reverse_proxy localhost:{{.Port}}
}
{{end}}

# ============================================================================
# EXAMPLES (commented out)
# ============================================================================

# Example 1: Multiple domains pointing to the same app
# example.com, www.example.com {
#     reverse_proxy localhost:{{.Port}}
# }

# Example 2: Subdomain
# app.example.com {
#     reverse_proxy localhost:{{.Port}}
# }

# Example 3: Static file server (for assets)
# static.example.com {
#     root * /var/www/static
#     file_server
# }

# Example 4: WebSocket support (enabled by default)
# ws.example.com {
#     reverse_proxy localhost:{{.Port}}
# }
