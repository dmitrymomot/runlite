[Unit]
Description=Runlite - Lightweight Go PaaS
Documentation=https://github.com/dmitrymomot/runlite
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/local/bin/runlite
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=runlite

# Security settings
NoNewPrivileges=false
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/runlite /etc/runlite

# Environment
Environment=PORT=8080

[Install]
WantedBy=multi-user.target
