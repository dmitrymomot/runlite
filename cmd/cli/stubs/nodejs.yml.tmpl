# yaml-language-server: $schema=https://runlite.dev/schema/runlite.yml.json
# RunLite Configuration
# See: https://github.com/dmitrymomot/runlite/blob/main/docs/config-file.md

app:
  name: {{.AppName}}

build:
  script: |
    npm ci
    npm run build
    npm prune --production

  # Copy build output and dependencies
  artifacts:
    - ./dist/
    - ./node_modules/
    - ./package.json

run:
  # Command to execute (relative to release directory)
  command: node dist/index.js

health:
  path: /health
  timeout: 60s
  interval: 2s

# Optional: Static files
# static:
#   path: ./public

# Optional: Deployment settings
# deploy:
#   drain_period: 30s
